<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <IncludePath>$(SICK_GENICAM_SDK)\SICK\include\ApiDll;$(SICK_GENICAM_SDK)\SICK\include\GenIRanger;$(SICK_GENICAM_SDK)\SICK\include\CalibrationWrapper;$(SICK_GENICAM_SDK)\tinyxml2;$(SICK_GENICAM_SDK)\GenICam\GenICam_V3_1_0\library\CPP\include;$(IncludePath)</IncludePath>
    <LibraryPath>$(SICK_GENICAM_SDK)\GenICam\GenICam_V3_1_0\library\CPP\lib\Win64_x64\;$(SICK_GENICAM_SDK)\SICK\lib\$(Configuration)\;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>GenIRanger.lib;SampleApiDll.lib;SampleCalibrationWrapper.lib;GCBase_MD_VC120_v3_1.lib;GenApi_MD_VC120_v3_1.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ClCompile>
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4251;4244;4091;</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>